# Copy to .env next to package.json and edit.

PORT=3000
HOST=0.0.0.0

# After you port-forward 3000 on your router, set this to the address
# friends should open. Examples:
# PUBLIC_URL=http://123.45.67.89:3000
# PUBLIC_URL=http://pacman.mydomain.com:3000

# Set to 1 to open a public Cloudflare tunnel (URL is saved in server-url.txt)
# WORLDWIDE=1
